module advanced_model_one
#(
    parameter [3:0] C1 = 4'h2,
    parameter [3:0] C2 = 4'h1,
    parameter [3:0] C3 = 4'h4,
    parameter [3:0] RED_POLY = 4'b0011   // x^4 + x + 1
)
(
    input  wire       clk,
    input  wire       rst_n,    // active-low reset
    input  wire       en,       // step enable
    input  wire       load,     // synchronous load
    input  wire [15:0] seed,
    output reg  [15:0] state
);

    // ────────────────────────────────────────────────
    // GF(16) multiplier - bit-serial style
    // ────────────────────────────────────────────────
    function [3:0] gf16_mul;
        input [3:0] a;
        input [3:0] b;
        reg [3:0] aa, bb, res;
        integer i;
        begin
            aa  = a;
            bb  = b;
            res = 4'd0;
            for (i = 0; i < 4; i = i + 1) begin
                if (bb[0])      res = res ^ aa;
                if (aa[3])      aa  = (aa << 1) ^ RED_POLY;
                else            aa  =  aa << 1;
                bb = bb >> 1;
            end
            gf16_mul = res;
        end
    endfunction

    // ────────────────────────────────────────────────
    // Current state unpacking
    // x3 (MSB/left) ... x0 (LSB/right, feedback tap)
    // ────────────────────────────────────────────────
    wire [3:0] x3 = state[15:12];   // MSB
    wire [3:0] x2 = state[11: 8];
    wire [3:0] x1 = state[ 7: 4];
    wire [3:0] x0 = state[ 3: 0];   // LSB = feedback tap

    wire [3:0] tap = x0;

    // ────────────────────────────────────────────────
    // Next-state logic
    // next_state = {nx3, nx2, nx1, nx0}
    // ────────────────────────────────────────────────
    wire [3:0] nx0 = x1;                            // LSB ← previous x1 (simple shift)
    wire [3:0] nx1 = x2 ^ gf16_mul(tap, C1);        // ← previous x2 + feedback×C1
    wire [3:0] nx2 = x3 ^ gf16_mul(tap, C2);        // ← previous x3 + feedback×C2
    wire [3:0] nx3 =          gf16_mul(tap, C3);    // MSB ← feedback×C3 (no shift term)

    wire [15:0] next_state = {nx3, nx2, nx1, nx0};

    // ────────────────────────────────────────────────
    // State register
    // ────────────────────────────────────────────────
    always @(posedge clk) begin
        if (!rst_n) begin
            state <= 16'h0001;      // non-zero to avoid all-zero lockup
        end
        else if (load) begin
            state <= seed;
        end
        else if (en) begin
            state <= next_state;
        end
    end

endmodule
