\usepackage{placeins}

\begin{document}
\begin{figure}[ht]
\centering
     \begin{tikzpicture}[node distance=2cm]
     
     
     
     %declaring 
     \node (start) [startstop] {Start};
     \node (in1) [io, below of=start] {\texttt{Input [3:0]a, [3:0]b, i = 0}};
     \node (proc0) [process, below of=in1, align=left] {
         \texttt{assign [3:0]temp\_a = a;}\\
         \texttt{assign [3:0]temp\_b = b;}};
    
     \node (dec1) [decision, below of=proc0] {\texttt{temp\_b[0] ==1}};
     \node (proc1) [process, below of=dec1] {\verb|res = res ^ temp_a;|};
     \node (dec2) [decision, below of=proc1] {\verb|temp_a[3] == 1|};
     \node (proc2) [process, right of=dec2, xshift = 4cm] {\verb|temp_a = temp_a << 1;|};
     \node (proc3) [process, below of=dec2] {\verb|temp_a = (temp_a << 1) ^ 4'b0011;|};
     \node (proc4) [process, below of=proc3] {\verb|temp_b >> 1;|};
     \node (proc6) [process, below of=proc4, inner sep=2pt]
{{\verb|i++|}};
     \node (dec3)  [decision, below of=proc6] {\verb|i < 4|};



     \node (stop) [startstop, below of=dec3] {Stop};

     %connecting together
     \draw [arrow] (start) -- (in1);
    \draw [arrow] (in1) -- (proc0);
    \draw [arrow] (proc0) -- (dec1);
    
    % dec1 branches
    \draw [arrow] (dec1.south) -- node[right]{True} (proc1.north);
    
    % after res update
    \draw [arrow] (proc1) -- (dec2);
    
    % dec2 branches
    \draw [arrow] (dec2.south) -- node[right]{True} (proc3.north);
    \draw [arrow] (dec2.east) -- node[above]{False} (proc2.west);
    
    % merge paths
    \draw [arrow] (proc2) |- (proc4);
    \draw [arrow] (proc3) -- (proc4);
    
    % loop control

    \draw [arrow] (proc6) --  (dec3);
    \draw [arrow] (proc4) -- (proc6);
    %\draw [arrow] (proc4) -- (dec3);
    \draw [arrow] (dec3.south) -- node[right]{False} (stop.north);
    \draw [arrow] (dec3.west) -- ++(-3,0)|- node[pos=0.25,above, xshift=-0.5cm]{True} (dec1.west);
    


     

    \end{tikzpicture}
\caption{Phép nhân của số 4bit a và số 4bit b trong $GF(2^4)$ với primitive polynomial $x^4 + x + 1$}
\end{figure}
