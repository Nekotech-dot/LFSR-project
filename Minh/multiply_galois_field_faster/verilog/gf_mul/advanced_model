from __future__ import annotations
import random
from typing import List, Tuple, Optional
import matplotlib.pyplot as plt

# ────────────────────────────────────────────────
# Constants
# ────────────────────────────────────────────────
MASK4      = 0xF
GF16_RED   = 0b0011          # x⁴ + x + 1
FULL_MASK  = 0xFFFF          # 16-bit state
MAX_STEPS  = 100_000         # safety limit for period detection


def gf16_mul(a: int, b: int, red: int = GF16_RED) -> int:
    """
    Multiply two elements in GF(2⁴) using polynomial x⁴ + x + 1.
    Bit-serial implementation (your original method).
    """
    a &= MASK4
    b &= MASK4
    res = 0
    for _ in range(4):
        if b & 1:
            res ^= a
        msb = (a >> 3) & 1
        a = (a << 1) & MASK4
        if msb:
            a ^= red
        b >>= 1
    return res


def step(state: int, c3: int, c2: int, c1: int, c0: int) -> int:
    """
    One step of the 4×4-bit nonlinear Galois register.
    state: 16-bit packed value (q3 q2 q1 q0)
    c3..c0: 4-bit coefficients
    Returns new 16-bit state.
    """
    q3 = (state >> 12) & MASK4
    q2 = (state >>  8) & MASK4
    q1 = (state >>  4) & MASK4
    q0 =  state        & MASK4

    # Feedback = c3·q3 ⊕ c2·q2 ⊕ c1·q1 ⊕ c0·q0  (in GF(2⁴))
    fb = (gf16_mul(q3, c3) ^
          gf16_mul(q2, c2) ^
          gf16_mul(q1, c1) ^
          gf16_mul(q0, c0)) & MASK4

    # Shift: q3 ← fb, q2 ← q3, q1 ← q2, q0 ← q1
    return ((fb  & MASK4) << 12) | \
           ((q3  & MASK4) <<  8) | \
           ((q2  & MASK4) <<  4) | \
            (q1  & MASK4)


def generate_sequence(
    seed: int,
    coeffs: Tuple[int, int, int, int],
    length: int = 20000,
    output_mode: str = "low_nibble"   # "low_nibble", "high_nibble", "full", "hamming"
) -> List[int]:
    """Generate sequence of output values from the system."""
    c3, c2, c1, c0 = coeffs
    s = seed & FULL_MASK
    seq = []
    
    for _ in range(length):
        if output_mode == "low_nibble":
            val = s & MASK4
        elif output_mode == "high_nibble":
            val = (s >> 12) & MASK4
        elif output_mode == "full":
            val = s
        elif output_mode == "hamming":
            val = bin(s).count("1")
        else:
            val = s & MASK4
            
        seq.append(val)
        s = step(s, c3, c2, c1, c0)
    
    return seq


def detect_period(
    seed: int,
    coeffs: Tuple[int, int, int, int],
    max_steps: int = MAX_STEPS
) -> Tuple[int, Optional[int]]:
    """
    Returns (length until repeat, period length) or (steps, None) if no repeat found.
    """
    c3, c2, c1, c0 = coeffs
    seen = {}
    s = seed & FULL_MASK
    for i in range(max_steps):
        if s in seen:
            return i, i - seen[s]
        seen[s] = i
        s = step(s, c3, c2, c1, c0)
    return max_steps, None


def plot_sequence_and_return_map(
    seq: List[int],
    title_suffix: str = "",
    figsize=(13, 8)
):
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=figsize, sharex=False)
    
    # Time series scatter
    ax1.scatter(range(len(seq)), seq,
                s=10, color='teal', alpha=0.7, edgecolor='none')
    ax1.set_title(f"Sequence scatter {title_suffix}")
    ax1.set_xlabel("Step t")
    ax1.set_ylabel("Value")
    ax1.grid(True, alpha=0.3, linestyle=':')
    
    # Return map
    ax2.scatter(seq[:-1], seq[1:],
                s=8, color='darkred', alpha=0.6, edgecolor='none')
    ax2.set_title("Return map: value(t) vs value(t+1)")
    ax2.set_xlabel("value(t)")
    ax2.set_ylabel("value(t+1)")
    ax2.grid(True, alpha=0.3)
    ax2.set_aspect('equal')
    
    plt.tight_layout()
    plt.show()


