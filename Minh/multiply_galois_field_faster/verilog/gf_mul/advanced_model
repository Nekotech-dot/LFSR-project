MASK4      = 0xF
GF16_RED   = 0b0011          # x⁴ + x + 1
FULL_MASK  = 0xFFFF          # 16-bit state
MAX_STEPS  = 100_000         # safety limit for period detection


def gf16_mul(a: int, b: int, red: int = GF16_RED) -> int:
    """
    Multiply two elements in GF(2⁴) using polynomial x⁴ + x + 1.
    Bit-serial implementation (your original method).
    """
    a &= MASK4
    b &= MASK4
    res = 0
    for _ in range(4):
        if b & 1:
            res ^= a
        msb = (a >> 3) & 1
        a = (a << 1) & MASK4
        if msb:
            a ^= red
        b >>= 1
    return res


def step(state: int, c3: int, c2: int, c1: int, c0: int) -> int:
    
    q3 = (state >> 12) & MASK4
    q2 = (state >>  8) & MASK4
    q1 = (state >>  4) & MASK4
    q0 =  state        & MASK4

    t = q0  # outgoing word

    nq0 = q1
    nq1 = (q2 ^ gf16_mul(t, c1)) & MASK4
    nq2 = (q3 ^ gf16_mul(t, c2)) & MASK4

    # For the top word, one common Galois pattern is:
    #   nq3 = gf16_mul(t, c3)  (plus any direct injection term).
    # If you want c0 to also influence feedback in Galois form, fold it here.
    nq3 = (gf16_mul(t, c3) ^ gf16_mul(t, c0)) & MASK4

    return ((nq3 & MASK4) << 12) | ((nq2 & MASK4) << 8) | ((nq1 & MASK4) << 4) | (nq0 & MASK4)
